generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  ANALYST
  OPERATOR
}

enum DraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXECUTED
  REJECTED
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  passwordHash    String?
  accounts        Account[]
  sessions        Session[]
  memberships     WorkspaceMember[]
  logs            AuditLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  members         WorkspaceMember[]
  connectors      ConnectorCredential[]
  rawEvents       RawEvent[]
  normalized      NormalizedEvent[]
  campaigns       Campaign[]
  adsets          Adset[]
  ads             Ad[]
  creatives       Creative[]
  adSpend         AdSpendDaily[]
  datasets        Dataset[]
  contacts        Contact[]
  companies       Company[]
  deals           Deal[]
  customers       Customer[]
  identities      IdentityMap[]
  drafts          CampaignDraft[]
  conversations   AgentConversation[]
  logs            AuditLog[]
  jobs            SyncJob[]
  createdAt       DateTime          @default(now())
}

model WorkspaceMember {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String
  role            Role
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
  @@unique([workspaceId, userId])
}

model ConnectorCredential {
  id              String    @id @default(cuid())
  workspaceId     String
  provider        String
  encryptedToken  String
  configJson      Json?
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model RawEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  source          String
  eventAt         DateTime
  payload         Json
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model NormalizedEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  customerId      String?
  eventName       String
  eventAt         DateTime
  revenue         Float?
  properties      Json
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
}

model Campaign {
  id              String   @id @default(cuid())
  workspaceId     String
  platform        String
  name            String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  adsets          Adset[]
}

model Adset {
  id              String   @id @default(cuid())
  workspaceId     String
  campaignId      String
  name            String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  campaign        Campaign  @relation(fields: [campaignId], references: [id])
  ads             Ad[]
}

model Ad {
  id              String   @id @default(cuid())
  workspaceId     String
  adsetId         String
  creativeId      String?
  name            String
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  adset           Adset     @relation(fields: [adsetId], references: [id])
  creative        Creative? @relation(fields: [creativeId], references: [id])
}

model Creative {
  id              String   @id @default(cuid())
  workspaceId     String
  body            String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  ads             Ad[]
}

model AdSpendDaily {
  id              String   @id @default(cuid())
  workspaceId     String
  campaignId      String?
  spendDate       DateTime
  spend           Float
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model Dataset {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  type            String
  schema          Json
  rows            Json
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model Contact {
  id              String   @id @default(cuid())
  workspaceId     String
  email           String?
  name            String
  source          String?
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model Company {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model Deal {
  id              String   @id @default(cuid())
  workspaceId     String
  companyId       String?
  stage           String
  value           Float
  source          String?
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model Customer {
  id              String   @id @default(cuid())
  workspaceId     String
  email           String?  @db.VarChar(320)
  attributes      Json
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  events          NormalizedEvent[]
  identities      IdentityMap[]
}

model IdentityMap {
  id               String   @id @default(cuid())
  workspaceId      String
  identifierType   String
  identifierValue  String
  customerId       String
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  customer         Customer  @relation(fields: [customerId], references: [id])
  @@unique([workspaceId, identifierType, identifierValue])
}

model CampaignDraft {
  id              String      @id @default(cuid())
  workspaceId     String
  platform        String
  payload         Json
  status          DraftStatus @default(DRAFT)
  createdBy       String
  workspace       Workspace   @relation(fields: [workspaceId], references: [id])
}

model AgentConversation {
  id              String   @id @default(cuid())
  workspaceId     String
  messages        Json
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model SyncJob {
  id              String   @id @default(cuid())
  workspaceId     String
  connector       String
  status          String
  error           String?
  lastRunAt       DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model AuditLog {
  id              String   @id @default(cuid())
  workspaceId     String
  userId          String?
  action          String
  metadata        Json?
  createdAt       DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  user            User?     @relation(fields: [userId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime
  @@unique([identifier, token])
}
